# Windows launchers must keep CRLF wherever they are checked out.
#
# cmd.exe cannot find a label in a file saved with plain LF: "goto :elevated"
# falls straight through, and the script does nothing while reporting nothing.
# That is how allow-phone.bat shipped broken - it looked fine, ran silently,
# and left the firewall untouched.
*.bat text eol=crlf
*.cmd text eol=crlf
*.vbs text eol=crlf
*.ps1 text eol=crlf

# Everything else is normalised to LF in the repository.
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf

# Binary, so git never touches the bytes.
*.ico binary
*.png binary
*.jpg binary
*.onnx binary
*.mp4 binary
